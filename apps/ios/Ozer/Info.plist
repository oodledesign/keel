<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>OZER_API_BASE</key>
	<string>$(OZER_API_BASE)</string>
	<key>OZER_SUPABASE_URL</key>
	<string>$(OZER_SUPABASE_URL)</string>
	<key>OZER_SUPABASE_ANON_KEY</key>
	<string>$(OZER_SUPABASE_ANON_KEY)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Ozer uses the microphone so you can dictate survey notes in the field and record in-room meetings. Audio stays on this iPhone.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Ozer transcribes dictation and meetings on this iPhone in British English, so notes still work offline. Speech is not sent to a cloud service.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>so.ozer.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>so.ozer.app</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
