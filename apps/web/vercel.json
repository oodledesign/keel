{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm run build --filter=web",
  "installCommand": "cd ../.. && pnpm install",
  "ignoreCommand": "bash ../../scripts/vercel-ignore.sh web",
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=5120",
      "NEXT_WEBPACK_PARALLELISM": "1",
      "UV_THREADPOOL_SIZE": "2",
      "ENABLE_STRICT_CSP": "true"
    }
  },
  "crons": [
    {
      "path": "/api/cron/rankly-rank-check",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/rankly-rank-check-worker",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/rankly-site-crawl-worker",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/rankly-pagespeed",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/rankly-gsc-sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/finance-freeagent-sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/finance-starling-sync",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/billing-trial-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/account-data-purge",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/billing-dunning-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/personal-people-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/commercial-match-digest",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/planner-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/booking-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/project-phase-due-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/invoice-overdue-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/invoices-recurring",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/cron/invoices-scheduled-send",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/email-campaigns-send",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/media-credits-expire",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/media-video-poll",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/video-analytics-sync",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/tasks-recurring",
      "schedule": "20 8 * * *"
    },
    {
      "path": "/api/cron/brain-reindex-active",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/email-follow-up-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/email-stuck-thread-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/gmail/sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/instagram-token-refresh",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/linkedin-token-refresh",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/linkedin-org-publish",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/feedflow-token-refresh",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/feedflow-media-ingest",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/ai/batch/submit",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/ai/batch/poll",
      "schedule": "0 */2 * * *"
    }
  ]
}
